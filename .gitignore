# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode — generated by XcodeGen, never committed
*.xcodeproj/
*.xcworkspace/
!*.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
xcuserdata/
*.xcuserstate
*.xcscmblueprint
DerivedData/
.build/
.build-*/
index/store/
*.moved-aside

# Swift Package Manager
.swiftpm/
Packages/
*.resolved

# Build artefacts
*.ipa
*.dSYM.zip
*.dSYM
*.hmap
*.o
*.app

# Signing / secrets — must never be committed
*.p12
*.cer
*.mobileprovision
*.entitlements.local
Config/Secrets.xcconfig
.env
.env.*
!/.env.example

# Tooling
.swiftlint-scratch/
coverage/
*.log
