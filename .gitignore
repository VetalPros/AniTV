# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode — generated by XcodeGen, never committed
*.xcodeproj/
*.xcworkspace/
# Generated by XcodeGen from project.yml (info.path), not a source file.
/App/Info.plist
!*.xcodeproj/project.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
xcuserdata/
*.xcuserdatad/
*.xcuserstate
*.xcscmblueprint
DerivedData/
.build/
.build-*/
index/store/
*.moved-aside

# Swift Package Manager
.swiftpm/
Packages/
*.resolved

# Build artefacts
*.ipa
*.dSYM.zip
*.dSYM
*.hmap
*.o
*.app

# Signing / secrets — must never be committed
*.p12
*.cer
*.mobileprovision
*.entitlements.local
Config/Secrets.xcconfig
# Local signing identity (DEVELOPMENT_TEAM); Config/Base.xcconfig includes it when present.
Config/Local.xcconfig
.env
.env.*
!/.env.example

# Test output
TestResults/
*.xcresult
*.profraw
*.profdata

# Tooling
.swiftlint-scratch/
coverage/
*.log
