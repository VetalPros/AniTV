    "placeholder.profile.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorization is not implemented: the app has no accounts, keeps no session and never sends tokens. This screen arrives together with sign-in support."
